ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...        # optional — enables real web search (https://tavily.com)
PLANNER_MODEL=claude-sonnet-5
AGENT_MODEL=claude-sonnet-5
TASK_TIMEOUT_MS=30000
TASK_MAX_RETRIES=3
TASK_MAX_TOKENS=4096
MANIFESTS_DIR=manifests
ENABLE_DECOMPOSER=true          # set to false to skip per-subtask decomposition
# DIRECT_AGENT_ID=CodeAgent     # enables auto-routing of single-agent tasks straight to this agent (skips the planner); unset = always plan
# SANDBOX_ENV_PASSTHROUGH=["NODE_OPTIONS"]  # extra env vars visible to bash_exec/python_exec (credentials are withheld by default)
AGENT_THINKING_EFFORT=medium  # global reasoning effort (low/medium/high/xhigh/max); "" = omit and use the model default; manifest/planner values take precedence
# REPORT_MODEL_TIER=standard     # tier for final report synthesis (economy/standard/premium); REPORT_MODEL pins a raw model id
# REPORT_MAX_TOKENS=16000
# REPORT_THINKING_EFFORT=low
