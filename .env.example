ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...        # optional — enables real web search (https://tavily.com)
PLANNER_MODEL=claude-sonnet-5-5
AGENT_MODEL=claude-opus-5-5
TASK_TIMEOUT_MS=30000
TASK_MAX_RETRIES=3
TASK_MAX_TOKENS=4096
MANIFESTS_DIR=manifests
ENABLE_DECOMPOSER=true          # set to false to skip per-subtask decomposition
# DIRECT_AGENT_ID=CodeAgent     # enables auto-routing of single-agent tasks straight to this agent (skips the planner); unset = always plan
# SANDBOX_ENV_PASSTHROUGH=["NODE_OPTIONS"]  # extra env vars visible to bash_exec/python_exec (credentials are withheld by default)
AGENT_THINKING_EFFORT=medium  # global reasoning effort (low/medium/high/xhigh/max); "" = omit and use the model default; manifest/planner values take precedence
# REPORT_MODEL_TIER=standard     # tier for final report synthesis (economy/standard/premium); REPORT_MODEL pins a raw model id
# REPORT_MAX_TOKENS=16000
# REPORT_THINKING_EFFORT=low
# DISPATCH_MODE=local            # "workers": run subtask agents in `agentflow worker` processes (needs STATE_BACKEND=redis + shared .runs/workspace)
# SANDBOX_BACKEND=local          # "docker": per-run container for exec tools (workspace at /workspace, no host credentials, fails closed)
# SANDBOX_DOCKER_NETWORK=bridge  # "none" isolates the sandbox from the network
# ENABLE_VERIFIER=true           # independently check subtasks that have acceptanceCriteria (read-only, economy tier)
# VERIFICATION_MAX_REPAIRS=1     # fix-and-recheck rounds before a failing subtask is downgraded to partial
# ENABLE_CHECKPOINTS=true        # git-snapshot each run's workspace per subtask into .runs/<id>/checkpoints.git; roll back failed attempts
# CAMPAIGN_MAX_FEATURE_ATTEMPTS=2  # campaign sessions a feature may fail verification before it is blocked
# CAMPAIGN_SESSION_MODEL=claude-sonnet-5-5   # a feature's first attempt; "" = the agent's default model
# CAMPAIGN_SESSION_THINKING_EFFORT=medium
# CAMPAIGN_ESCALATION_MODEL=                 # a feature that failed or regressed; "" = the agent's default model
# CAMPAIGN_ESCALATION_THINKING_EFFORT=high
# CAMPAIGN_SESSION_MAX_ITERATIONS=40         # per session invocation, before a continuation
# CAMPAIGN_DEFAULT_SESSION_BUDGET_USD=3.0    # when a campaign request sets no session_budget_usd
# VERIFIER_MAX_ITERATIONS=12
# CONTEXT_SNIP_TRIGGER_TOKENS=100000  # stub older tool results in the model's view past this prompt size (full history kept; recall_tool_result restores); 0 = off
# RUN_LEASE_TTL_S=15             # Redis backend: per-run ownership lease TTL (renewed every TTL/3s; bounds cross-replica cancel latency)
# RESUME_INTERRUPTED_RUNS=false  # resume runs interrupted by a restart at startup (spends budget unprompted); else use POST /api/runs/{id}/resume
